{
  "model_name": "bert-base-multilingual-cased",
  "data_dir": "idioms_structured/Splits",
  "dropout": 0.1,
  "output_dir": "models/language_ablation_matrix/es_hi/joint_mbert",
  "langs": [
    "Spanish",
    "Hindi"
  ],
  "test_langs": [
    "English",
    "Spanish",
    "Hindi",
    "Telugu",
    "Indonesian"
  ],
  "epochs": 7,
  "batch_size": 32,
  "lr": 2e-05,
